<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <!-- El WebView de Capacitor necesita INTERNET para inicializar su pila de
         red aunque todo el contenido salga de assets/. El juego no hace ni una
         peticion: se verifica en CI con scripts/metrics.mjs, que falla si
         aparece cualquier dominio externo en el bundle. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La pantalla no se apaga mientras se juega. El WebView no siempre expone
         la Screen Wake Lock API, asi que MainActivity anade el flag nativo
         FLAG_KEEP_SCREEN_ON como red de seguridad. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <!-- WebGL2 necesita OpenGL ES 3.0. Un telefono que no lo tenga no puede
         ejecutar el juego, y es mejor que Play/el instalador lo sepan. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
</manifest>
