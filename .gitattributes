# Normalización de finales de línea. Sin esto, un checkout en Windows puede
# dejar CRLF en gradlew y el runner de Linux de CI falla con
# "bad interpreter: No such file or directory".
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.jar  binary
*.apk  binary
*.keystore binary
